# Google Apps Script web app URL (Deploy → Web app → copy /exec URL)
GOOGLE_APPS_SCRIPT_URL=

# Google Maps Platform — preferred for browse map + static previews (usually $0 within free monthly caps).
# Enable Maps JavaScript API + Static Maps API in Google Cloud Console.
# Restrict key by HTTP referrer (production domain + localhost). See docs/google-maps.md.
VITE_GOOGLE_MAPS_API_KEY=
# Netlify / Next alias (either works):
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional Leaflet fallback when Google is unset: CARTO Voyager (needs a free basemap key).
# Without this key, Leaflet uses OpenStreetMap tiles (no “API key required” watermark).
# Request at https://carto.com/basemaps/apikey/ — Netlify: NEXT_PUBLIC_CARTO_BASEMAP_API_KEY
NEXT_PUBLIC_CARTO_BASEMAP_API_KEY=
# Optional Vite alias for local vite/dev:
# VITE_CARTO_BASEMAP_API_KEY=

# Optional: protect admin write actions (update status, promote to Events tab)
# Set the same value in Netlify env and VITE_PUDDLES_API_KEY for the admin dashboard
PUDDLES_API_SECRET=
VITE_PUDDLES_API_KEY=

# Admin dashboard password (server-only — set on Netlify, not in VITE_* vars)
# When set, /admin requires sign-in and CSV/API proxies check the session cookie.
ADMIN_PASSWORD=
# Optional: separate secret for signing admin session cookies (defaults to ADMIN_PASSWORD)
ADMIN_SESSION_SECRET=

# Plausible analytics loads automatically on puddlesmap.com (see index.html).

# PostHog (product analytics) — set on Netlify for production.
# Project API Key from https://us.posthog.com/settings/project (starts with phc_)
# Client uses /ingest reverse proxy — NEXT_PUBLIC_POSTHOG_HOST is not required.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Optional: set to true to allow PostHog capture on localhost only (debug).
# NEXT_PUBLIC_POSTHOG_DEBUG=true

# Admin "Publish to site" — GitHub fine-grained PAT with Actions: Read and write on this repo.
# Create at github.com/settings/tokens?type=beta → Repository access: puddles-v2 only.
GITHUB_DEPLOY_TOKEN=
# Optional override (default: puddlesmap/puddles-v2)
# GITHUB_REPO=puddlesmap/puddles-v2

# Social Studio → Notion Content Calendar. Leave NOTION_TOKEN unset to save the weekly folder only.
# On Netlify, Approve skips the Mac folder and updates Notion when NOTION_TOKEN is set.
# Create an internal integration at https://www.notion.so/my-integrations and share
# "Puddles Content Calendar" with it. Approve item then writes the caption to that database.
# NOTION_TOKEN=
# NOTION_CONTENT_CALENDAR_ID=4569d58b-1370-828f-af8b-07f481ff30e8
# NOTION_INSTAGRAM_CHANNEL_ID=f4c9d58b-1370-831e-9c17-01230d568cad
# NOTION_REDBOOK_CHANNEL_ID=3979d58b-1370-8054-8bac-f90d63715663

# Social Studio. Leave unset to stay in mock mode (nothing is sent to Instagram).
# SOCIAL_PUBLISH_MODE=live
# INSTAGRAM_APP_ID=
# INSTAGRAM_APP_SECRET=
# Must match the Meta app redirect, for example https://puddlesmap.com/api/instagram-oauth
# INSTAGRAM_REDIRECT_URI=
# Optional email when a manual story is due or a post fails.
# SOCIAL_ALERT_EMAIL=
# RESEND_API_KEY=
