{
  "name": "puddles-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "dev:vite": "vite",
    "build:vite": "node scripts/generate-sitemap.mjs && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "next start",
    "parse-events": "node scripts/sync-events.mjs",
    "sync-events": "node scripts/sync-events.mjs",
    "sync-submissions": "node scripts/sync-submissions.mjs",
    "sync-all": "npm run sync-events && npm run sync-submissions",
    "discover:palo-alto": "node scripts/discover-palo-alto.mjs",
    "discover:los-altos": "node scripts/discover-los-altos.mjs",
    "discover:mountain-view": "node scripts/discover-mountain-view.mjs",
    "discover:bay-area": "node scripts/discover-bay-area.mjs",
    "discover:linden-tree": "node scripts/discover-linden-tree.mjs",
    "discover:expansion-lookahead": "node scripts/discover-expansion-lookahead.mjs",
    "discover:expansion-refresh": "node scripts/discover-expansion-lookahead.mjs --days=90 --run-scrape",
    "discover:ingest-expansion": "node scripts/ingest-watchlist-expansion.mjs",
    "discover:regional-weekly": "node scripts/discover-regional-weekly.mjs",
    "discover:sync-seasonal": "node scripts/sync-seasonal-discovery.mjs",
    "build:launch-staging": "node scripts/build-launch-staging.mjs",
    "verify-expansion-watch": "node scripts/verify-expansion-watch-submission.mjs"
  },
  "dependencies": {
    "@netlify/plugin-nextjs": "^5.15.12",
    "@tailwindcss/postcss": "^4.3.2",
    "@vis.gl/react-google-maps": "^1.8.3",
    "leaflet": "^1.9.4",
    "next": "^15.5.20",
    "posthog-js": "^1.404.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/google.maps": "^3.65.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  }
